@model Assessment.Models.BlogPostModel
@using System.Linq
@using System.Web
@{
    Layout = null;
    ViewBag.Title = Model == null || string.IsNullOrWhiteSpace(Model.Title) ? "NetConstruct Blog" : Model.Title;
    var comments = Model == null || Model.Comments == null
        ? Enumerable.Empty<Assessment.Models.CommentModel>()
        : Model.Comments;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="@Url.Content("~/Content/bootstrap.min.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/Site.css")" />
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Blog")">NetConstruct Blog</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarResponsive" aria-controls="navbarResponsive" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarResponsive">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link active" aria-current="page" href="@Url.Action("Index", "Blog")">Home</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container" style="padding-top: 5rem;">
        <div class="row">
            <div class="col-lg-12">
                @if (Model == null)
                {
                    <div class="alert alert-warning mt-4">No blog post is available.</div>
                }
                else
                {
                    <h1 class="mt-4">@Model.Title</h1>
                    <p class="text-muted">Posted on @Model.Date.ToString("MMMM d, yyyy")</p>
                    <img class="img-fluid rounded" src="@Model.Image" alt="@Model.Title" />
                    <div class="mt-4">
                        @Html.Raw(Model.HtmlContent)
                    </div>

                    <hr />

                    <div class="card my-4">
                        <h5 class="card-header">Leave a Comment:</h5>
                        <div class="card-body">
                            <form>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label for="Name" class="form-label">Name</label>
                                        <input type="text" class="form-control" id="Name" placeholder="Name" />
                                    </div>
                                    <div class="col-md-6">
                                        <label for="EmailAddress" class="form-label">Email Address</label>
                                        <input type="email" class="form-control" id="EmailAddress" placeholder="Email Address" />
                                    </div>
                                </div>

                                <div class="mt-3">
                                    <label for="Message" class="form-label">Message</label>
                                    <textarea id="Message" class="form-control" rows="3"></textarea>
                                </div>
                                <button type="submit" class="btn btn-primary mt-3">Submit</button>
                            </form>
                        </div>
                    </div>

                    <div class="mt-4">
                        @if (comments.Any())
                        {
                            foreach (var comment in comments)
                            {
                                <div class="d-flex mb-4">
                                    <img class="flex-shrink-0 rounded-circle me-3 user-avatar" src="https://eu.ui-avatars.com/api/?name=@HttpUtility.UrlEncode(comment.Name)" alt="@comment.Name" />
                                    <div class="flex-grow-1">
                                        <h5 class="mt-0">
                                            @comment.Name
                                            <small><em>(@comment.Date.ToString("MMMM d, yyyy - HH:mm"))</em></small>
                                        </h5>
                                        <p class="mb-0">@comment.Message</p>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted">No comments yet.</p>
                        }
                    </div>
                }
            </div>
        </div>
    </main>

    <script src="@Url.Content("~/Scripts/jquery-3.4.1.min.js")"></script>
    <script src="@Url.Content("~/Scripts/bootstrap.bundle.min.js")"></script>
</body>
</html>
